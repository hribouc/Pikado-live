px;padding:10px 0;border-bottom:1px solid #294440}</style><main><section class=\"card cloud-card\"><b>☁️ Skupna shramba</b><div id=\"cloudStatus\" role=\"status\" aria-live=\"polite\">Povezujem Google Drive …</div><div class=\"actions\"><button id=\"cloudRefresh\" class=\"outline\">↻ Osveži</button><button id=\"exportData\" class=\"outline\">Izvozi kopijo</button><button id=\"importData\" class=\"outline\">Uvozi kopijo</button><input id=\"importFile\" type=\"file\" accept=\".json,application/json\" class=\"hidden\"></div></section><div id=\"appContent\"><header><div><h1>🎯 PIKADO <span style=\"color:#b7f65a\">LIVE</span></h1><small>Rezultati · skupna shramba · v12</small></div><button id=\"settingsBtn\" class=\"outline\">⚙️ Nastavitve</button></header><section id=\"setup\" class=\"card\"><h2>Nova igra</h2><div class=\"settings\"><div><label>Začetni rezultat</label><select id=\"start\"><option>501</option><option>301</option></select></div><div><label>Zaključek</label><select id=\"finish\"><option value=\"single\">Brez Double Out</option><option value=\"double\">Double Out</option></select></div></div><label>Število igralcev</label><div class=\"flex\"><button id=\"minus\">−</button><strong id=\"countLabel\" style=\"font-size:26px\">2</strong><button id=\"plus\">+</button></div><div id=\"names\" class=\"names\" style=\"margin-top:12px\"></div><button class=\"primary\" id=\"new\" style=\"width:100%;margin-top:16px\">ZAČNI IGRO →</button><div class=\"actions\"><button id=\"soundTest\">🔊 Preizkusi glas</button><button id=\"resetStats\" class=\"outline\">Ponastavi lestvico</button></div><div class=\"voiceStatus\" id=\"soundInfo\">Rezultate vnašaš ročno.</div></section><div id=\"game\"><section class=\"card\"><div class=\"flex\"><b>TEKOČA IGRA</b><span class=\"pill\" id=\"round\">1. krog</span></div><div class=\"scores\" id=\"scores\" style=\"margin-top:12px\"></div></section><section class=\"card\"><div class=\"hero\"><small>NA POTEZI</small><h2 id=\"current\">Igralec 1</h2><div class=\"number\" id=\"remaining\">501</div><div class=\"checkout\" id=\"checkout\"></div></div><div class=\"win hidden\" id=\"winner\"></div><form class=\"entry\" id=\"entry\"><input type=\"number\" id=\"points\" min=\"0\" max=\"180\" inputmode=\"numeric\" placeholder=\"Točke\" required><button class=\"primary\" type=\"submit\">✓</button></form><div class=\"voiceStatus\" id=\"status\">Vnesi skupni rezultat treh puščic.</div><div class=\"actions\"><button id=\"undo\" class=\"outline\">↶ Razveljavi</button><button id=\"nextGame\" class=\"primary hidden\">↻ Nova igra</button><button id=\"soundGame\" class=\"outline\">🔊 Test</button></div></section></div><section class=\"card\"><div class=\"flex\"><h2 style=\"margin:0\">🏆 Lestvica</h2><span class=\"pill\">Skupno vse igre</span></div><table class=\"table\"><thead><tr><th>Igralec</th><th>Zmage</th><th>Porazi</th><th>Uspešnost</th></tr></thead><tbody id=\"ranking\"></tbody></table></section><section class=\"card\"><h2>Zgodovina iger</h2><div id=\"historyList\"></div><small>Prikazanih je zadnjih 30 iger. Celotno evidenco izvoziš z gumbom Izvozi kopijo.</small></section></div></main><script>\nconst $=id=>document.getElementById(id),KEY='pikado-drive-cache-v1';let db={count:2,names:[],stats:{},game:null,games:[]},audioCtx=null;try{const x=JSON.parse(localStorage.getItem(KEY));if(x&&typeof x==='object')db={...db,...x}}catch{};function beep(){try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume();[523,659,784,1047].forEach((f,i)=>{let o=audioCtx.createOscillator(),g=audioCtx.createGain(),t=audioCtx.currentTime+i*.13;o.type='triangle';o.frequency.value=f;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.16,t+.025);g.gain.exponentialRampToValueAtTime(.0001,t+.22);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+.23)})}catch{}}function speak(s){beep();if(!('speechSynthesis'in window)){msg('Govorna najava v tem brskalniku ni podprta.');return}try{speechSynthesis.cancel();let u=new SpeechSynthesisUtterance(s);u.lang='sl-SI';u.rate=.92;u.volume=1;speechSynthesis.speak(u)}catch(e){msg('Govorna najava ni uspela.')}}function msg(t){$('status').textContent=t;$('soundInfo').textContent=t}function names(){let old=[...$('names').querySelectorAll('input')].map(e=>e.value);if(old.length)db.names=old;db.names=Array.from({length:db.count},(_,i)=>db.names[i]||'Igralec '+(i+1));$('countLabel').textContent=db.count;$('names').replaceChildren();db.names.forEach((v,i)=>{let e=document.createElement('input');e.value=v;e.placeholder='Igralec '+(i+1);e.oninput=()=>{db.names[i]=e.value;persist()};$('names').append(e)})}function ranking(){let rows=Object.entries(db.stats).map(([name,s])=>({name,...s})).sort((a,b)=>b.w-a.w||a.l-b.l);$('ranking').replaceChildren();if(!rows.length){let tr=document.createElement('tr');tr.innerHTML='<td colspan=\"4\">Lestvica je še prazna.</td>';$('ranking').append(tr)}rows.forEach(s=>{let tr=document.createElement('tr');[s.name,s.w,s.l,Math.round(100*s.w/(s.w+s.l||1))+' %'].forEach(v=>{let td=document.createElement('td');td.textContent=v;tr.append(td)});$('ranking').append(tr)})}\nconst checkoutCache=new Map();\nfunction checkoutRoutes(score,finish){\n const key=score+':'+finish;if(checkoutCache.has(key))return checkoutCache.get(key);\n const doubleOut=finish==='double';\n if(!Number.isInteger(score)||score<=0||score>(doubleOut?170:180))return [];\n const fields=[];\n for(let n=20;n>=1;n--)fields.push({label:'S'+n,value:n,difficulty:0});\n fields.push({label:'25',value:25,difficulty:3});\n for(let n=20;n>=1;n--)fields.push({label:'D'+n,value:2*n,difficulty:2,double:true});\n fields.push({label:'BULL',value:50,difficulty:4,double:true});\n for(let n=20;n>=1;n--)fields.push({label:'T'+n,value:3*n,difficulty:3});\n fields.forEach((field,index)=>field.order=index);\n const endings=new Map();\n for(const field of fields){if(doubleOut&&!field.double)continue;const list=endings.get(field.value)||[];list.push(field);endings.set(field.value,list)}\n const routes=[],seen=new Set();\n const add=prefix=>{\n  const remaining=score-prefix.reduce((sum,field)=>sum+field.value,0);\n  for(const last of endings.get(remaining)||[]){\n   const route=[...prefix,last];\n   const canonical=doubleOut?[...prefix.map(f=>f.label).sort(),last.label]:route.map(f=>f.label).sort();\n   const id=canonical.join('/');if(seen.has(id))continue;seen.add(id);routes.push(route);\n  }\n };\n add([]);\n for(let i=0;i<fields.length;i++){\n  const first=fields[i];if(first.value>=score)continue;add([first]);\n  for(let j=i;j<fields.length;j++){\n   const second=fields[j];if(first.value+second.value>=score)continue;add([first,second]);\n  }\n }\n routes.sort((a,b)=>a.length-b.length||a.reduce((s,f)=>s+f.difficulty,0)-b.reduce((s,f)=>s+f.difficulty,0)||a.reduce((s,f)=>s+f.order,0)-b.reduce((s,f)=>s+f.order,0)||a.map(f=>f.label).join('/').localeCompare(b.map(f=>f.label).join('/')));\n const result=routes.slice(0,3).map(route=>route.map(f=>({label:f.label,value:f.value})));\n checkoutCache.set(key,result);return result;\n}\nfunction renderCheckout(game){\n const box=$('checkout');box.replaceChildren();if(game.done)return;\n const score=game.players[game.active].score,routes=checkoutRoutes(score,game.finish);\n const title=document.createElement('div');\n if(!routes.length){if(score<=180){title.textContent='Za ta rezultat ni zaključka v treh puščicah.';box.append(title)}return}\n title.textContent='🎯 Zaključek · '+score+' točk';box.append(title);\n routes.forEach((route,index)=>{\n  const line=document.createElement('div');line.className='checkout-route';\n  const number=route.length===1&&route[0].label.startsWith('T')?' (3 × '+route[0].label.slice(1)+')':'';\n  line.textContent=(index===0?'Predlog: ':'Možnost: ')+route.map(f=>f.label).join(' → ')+number;\n  box.append(line);\n });\n const legend=document.createElement('small');legend.textContent='S = enojno · D = dvojno · T = trojno · 25 = zunanji bull · BULL = 50';\n box.append(legend);\n}\n\nfunction render(){let g=db.game;document.body.classList.toggle('playing',!!g);$('setup').classList.toggle('hidden',!!g);$('game').classList.toggle('active',!!g);ranking();renderHistory();if(!g){persist();return;}$('round').textContent=g.round+'. krog';$('scores').replaceChildren();g.players.forEach((p,i)=>{let e=document.createElement('div');e.className='scorecard'+(g.active===i&&!g.done?' active':'');let n=document.createElement('span'),s=document.createElement('b');n.textContent=p.name;s.textContent=p.score;e.append(n,s);$('scores').append(e)});let p=g.players[g.active];$('current').textContent=p.name;$('remaining').textContent=p.score;$('entry').classList.toggle('hidden',g.done);$('nextGame').classList.toggle('hidden',!g.done);$('winner').classList.toggle('hidden',!g.done);$('winner').textContent=g.done?'🏆 Zmagovalec: '+g.players[g.winner].name:'';$('undo').disabled=!g.history.length;renderCheckout(g);persist()}\nfunction begin(){db.names=[...$('names').querySelectorAll('input')].map((e,i)=>e.value.trim()||'Igralec '+(i+1));let names=[...new Set(db.names)];if(names.length!==db.names.length){msg('Vsak igralec potrebuje različno ime.');return}let start=+$('start').value;db.game={id:Date.now()+'-'+Math.random().toString(36).slice(2),startedAt:new Date().toISOString(),start,finish:$('finish').value,players:db.names.map(name=>({name,score:start})),active:0,round:1,history:[],done:false,winner:null};persist();render()}function submit(n){let g=db.game;if(!g||g.done)return;if(!Number.isInteger(n)||n<0||n>180){msg('Vnesi celo število med 0 in 180.');return}let snapshot=JSON.parse(JSON.stringify({players:g.players,active:g.active,round:g.round,done:g.done,winner:g.winner,stats:db.stats}));g.history.push(snapshot);let p=g.players[g.active],r=p.score-n,bust=r<0||(g.finish==='double'&&r===1);if(r===0&&g.finish==='double'&&!confirm('Je zadnja puščica zadela dvojno polje?'))bust=true;if(!bust)p.score=r;if(r===0&&!bust){g.done=true;g.winner=g.active;g.players.forEach((x,i)=>{let s=db.stats[x.name]||(db.stats[x.name]={w:0,l:0});if(i===g.winner)s.w++;else s.l++});archiveGame(g);render();speak('Zmagovalec je '+p.name+'!');msg('Igra zaključena.');return}if(!bust&&r===0){}g.active=(g.active+1)%g.players.length;if(g.active===0)g.round++;$('points').value='';msg(bust?'BUST! Rezultat ostane nespremenjen.':'Vpisano: '+n);render()}\n$('minus').onclick=()=>{db.count=Math.max(1,db.count-1);names();persist()};$('plus').onclick=()=>{db.count=Math.min(8,db.count+1);names();persist()};$('new').onclick=begin;$('settingsBtn').onclick=()=>{if(db.game&&!confirm('Zapustim tekočo igro? Rezultati te igre se ne bodo šteli.'))return;db.game=null;render()};$('nextGame').onclick=()=>{const g=db.game;if(!g?.done)return;db.game={id:Date.now()+'-'+Math.random().toString(36).slice(2),startedAt:new Date().toISOString(),start:g.start,finish:g.finish,players:g.players.map(p=>({name:p.name,score:g.start})),active:0,round:1,history:[],done:false,winner:null};$('points').value='';msg('Nova igra. Na potezi: '+db.game.players[0].name+'.');render()};$('entry').onsubmit=e=>{e.preventDefault();submit(+$('points').value)};$('undo').onclick=()=>{let g=db.game;if(!g?.history.length)return;let x=g.history.pop();if(g.done)db.games=(db.games||[]).filter(item=>item.id!==g.id);Object.assign(g,{players:x.players,active:x.active,round:x.round,done:x.done,winner:x.winner});db.stats=x.stats;render();msg('Zadnji met razveljavljen.')};$('resetStats').onclick=()=>{if(confirm('Izbrišem vse zmage in poraze?')){db.stats={};render()}};$('soundTest').onclick=()=>speak('Preizkus zvoka. Pikado je pripravljen.');$('soundGame').onclick=()=>speak('Preizkus zvoka.');\n\nlet cloudReady=false,cloudBusy=false,cloudRevision=0,cloudSaved='',cloudDirty=false,cloudConflict=false,cloudTimer=null,cloudRequest=null;\nconst cloudCacheKey='pikado-drive-cache-v1',cloudPendingKey='pikado-drive-pending-v1';\nfunction setCloudStatus(text){$('cloudStatus').textContent=text;}\nfunction rememberLocal(){try{localStorage.setItem(cloudCacheKey,JSON.stringify(db));if(cloudDirty)localStorage.setItem(cloudPendingKey,JSON.stringify(db));}catch{}}\nfunction persist(){\n rememberLocal();if(!cloudReady||cloudConflict)return;\n cloudDirty=JSON.stringify(db)!==cloudSaved;\n if(cloudDirty){setCloudStatus('Spremembe čakajo na shranjevanje …');clearTimeout(cloudTimer);cloudTimer=setTimeout(saveCloud,400);}\n}\nfunction callCloud(method,arg){return new Promise((resolve,reject)=>{const call=google.script.run.withSuccessHandler(resolve).withFailureHandler(error=>reject(new Error(error.message||'Povezava z Google Drive ni uspela.')));if(method==='loadState')call.loadState();else call.saveState(arg);});}\nfunction lockApp(locked){$('appContent').inert=locked;$('appContent').style.opacity=locked?'.55':'';}\nasync function saveCloud(){\n if(!cloudReady||cloudBusy||cloudConflict)return;\n const serialized=JSON.stringify(db);if(serialized===cloudSaved){cloudDirty=false;return;}\n cloudBusy=true;cloudDirty=true;rememberLocal();setCloudStatus('Shranjujem v Google Drive …');\n if(!cloudRequest||cloudRequest.serialized!==serialized)cloudRequest={serialized,requestId:crypto.randomUUID?crypto.randomUUID():Date.now()+'-'+Math.random()};\n try{\n  const result=await callCloud('saveState',{revision:cloudRevision,requestId:cloudRequest.requestId,db:JSON.parse(serialized)});\n  if(!result.ok){cloudConflict=true;lockApp(true);setCloudStatus('Podatke je spremenila druga naprava. Izvozi lokalno kopijo in klikni Osveži.');return;}\n  cloudRevision=result.revision;cloudSaved=serialized;cloudRequest=null;cloudDirty=JSON.stringify(db)!==cloudSaved;\n  if(cloudDirty)cloudTimer=setTimeout(saveCloud,100);\n  else{try{localStorage.removeItem(cloudPendingKey)}catch{}setCloudStatus('✓ Shranjeno v Google Drive · '+new Date(result.updatedAt).toLocaleTimeString('sl-SI',{hour:'2-digit',minute:'2-digit'}));}\n }catch(error){setCloudStatus('Ni shranjeno v Drive. Lokalna kopija ostaja na napravi. Ponovni poskus čez 10 sekund.');cloudTimer=setTimeout(saveCloud,10000);}\n finally{cloudBusy=false;}\n}\nasync function loadCloud(manual=false){\n if(cloudBusy)return;\n if(manual&&(cloudDirty||cloudConflict)&&!confirm('Naložim skupne podatke? Lokalna kopija ostane na tej napravi. Pred tem jo lahko izvoziš.'))return;\n cloudBusy=true;lockApp(true);setCloudStatus('Nalagam skupne podatke iz Google Drive …');\n try{\n  const record=await callCloud('loadState');cloudRevision=record.revision;\n  db={count:2,names:[],stats:{},game:null,games:[],...record.db};cloudSaved=JSON.stringify(db);cloudReady=true;cloudDirty=false;cloudConflict=false;cloudRequest=null;\n  $('names').replaceChildren();names();render();lockApp(false);\n  setCloudStatus('✓ Povezano z Google Drive'+(record.updatedAt?' · '+new Date(record.updatedAt).toLocaleString('sl-SI'):' · pripravljeno za prvo igro'));\n }catch(error){setCloudStatus('Google Drive ni dosegljiv. Klikni Osveži za ponovni poskus.');}\n finally{cloudBusy=false;}\n}\nfunction renderHistory(){\n const box=$('historyList');if(!box)return;box.replaceChildren();\n const games=db.games||[];\n if(!games.length){box.textContent='Končane igre se bodo samodejno shranile tukaj.';return;}\n [...games].reverse().slice(0,30).forEach(game=>{\n  const row=document.createElement('div');row.className='history-row';\n  row.textContent=new Date(game.finishedAt).toLocaleString('sl-SI')+' · '+game.start+' · Zmagovalec: '+game.winner+' · '+game.players.map(p=>p.name+': '+p.score).join(' / ');\n  box.append(row);\n });\n}\nfunction archiveGame(game){\n db.games=db.games||[];if(!game.id)game.id=Date.now()+'-'+Math.random().toString(36).slice(2);\n if(db.games.some(item=>item.id===game.id))return;\n db.games.push({id:game.id,startedAt:game.startedAt||null,finishedAt:new Date().toISOString(),start:game.start,finish:game.finish,winner:game.players[game.winner].name,players:game.players.map(p=>({name:p.name,score:p.score})),rounds:game.round});\n}\nfunction exportData(){\n const blob=new Blob([JSON.stringify({schema:1,exportedAt:new Date().toISOString(),db},null,2)],{type:'application/json'});\n const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='pikado-varnostna-kopija-'+new Date().toISOString().slice(0,10)+'.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),2000);\n}\n$('cloudRefresh').onclick=()=>loadCloud(true);\n$('exportData').onclick=exportData;\n$('importData').onclick=()=>$('importFile').click();\n$('importFile').onchange=async event=>{\n const file=event.target.files[0];event.target.value='';if(!file||!cloudReady||cloudBusy||cloudConflict)return;\n try{\n  if(file.size>2000000)throw Error('Datoteka je prevelika.');\n  const content=JSON.parse(await file.text()),imported=content.db||content;\n  if(!imported||!Number.isInteger(imported.count)||!Array.isArray(imported.names)||!imported.stats)throw Error('Datoteka ni veljavna kopija aplikacije.');\n  if(!confirm('Uvoz zamenja skupne podatke. Najprej izvozi trenutno varnostno kopijo. Nadaljujem?'))return;\n  db={...imported,games:imported.games||[]};$('names').replaceChildren();names();render();await saveCloud();\n }catch(error){alert('Uvoz ni uspel: '+error.message);}\n};\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden&&cloudReady&&!cloudDirty&&!cloudBusy&&!cloudConflict)pollCloud();});\nasync function pollCloud(){\n if(!cloudReady||cloudBusy||cloudDirty||cloudConflict||document.hidden)return;\n cloudBusy=true;try{const record=await callCloud('loadState');if(record.revision!==cloudRevision){cloudRevision=record.revision;db={...record.db,games:record.db.games||[]};cloudSaved=JSON.stringify(db);$('names').replaceChildren();names();render();setCloudStatus('✓ Posodobljeno iz druge naprave');}}catch{}finally{cloudBusy=false;}\n}\nsetInterval(pollCloud,15000);\nwindow.addEventListener('beforeunload',event=>{if(cloudDirty){event.preventDefault();event.returnValue='';}});\nlockApp(true);loadCloud();\n\n</script></html