function dataFolder_(){
 const props=PropertiesService.getScriptProperties(),saved=props.getProperty('DATA_FOLDER_ID');
 if(saved)return DriveApp.getFolderById(saved);
 const folders=DriveApp.getFoldersByName('Pikado LIVE'),folder=folders.hasNext()?folders.next():DriveApp.createFolder('Pikado LIVE');
 props.setProperty('DATA_FOLDER_ID',folder.getId());return folder;
}
function doGet() {
 return HtmlService.createHtmlOutput(APP_HTML).setTitle('PIKADO LIVE').addMetaTag('viewport','width=device-width,initial-scale=1,viewport-fit=cover');
}
function authorize_() {
 const email=Session.getActiveUser().getEmail();
 if(email&&email.toLowerCase()!==Session.getEffectiveUser().getEmail().toLowerCase())throw new Error('Dostop je dovoljen samo lastniku aplikacije.');
}
function defaultState_(){return {count:2,names:['Igralec 1','Igralec 2'],stats:{},game:null,games:[]};}
function readStore_() {
 const properties=PropertiesService.getScriptProperties();let id=properties.getProperty('STATE_FILE_ID'),file;
 if(id){file=DriveApp.getFileById(id);}
 else {
  const folder=dataFolder_(),files=folder.getFilesByName('pikado-podatki.json');
  if(files.hasNext())file=files.next();
  else file=folder.createFile('pikado-podatki.json',JSON.stringify({schema:1,revision:0,updatedAt:null,db:defaultState_(),lastRequestId:null}),MimeType.PLAIN_TEXT);
  properties.setProperty('STATE_FILE_ID',file.getId());
 }
 const record=JSON.parse(file.getBlob().getDataAsString('UTF-8'));
 if(record.schema!==1||!Number.isInteger(record.revision)||!record.db)throw new Error('Podatki niso veljavni. Obnovi jih iz varnostne kopije.');
 return {file:file,record:record};
}
function loadState(){
 authorize_();const lock=LockService.getScriptLock();lock.waitLock(15000);
 try{return readStore_().record;}finally{lock.releaseLock();}
}
function validateState_(db){
 if(!db||typeof db!=='object'||Array.isArray(db))throw new Error('Neveljavni podatki.');
 if(!Number.isInteger(db.count)||db.count<1||db.count>8||!Array.isArray(db.names)||db.names.length>8)throw new Error('Neveljavni igralci.');
 if(db.names.some(n=>typeof n!=='string'||n.length>80))throw new Error('Ime igralca je predolgo.');
 if(!db.stats||typeof db.stats!=='object'||Array.isArray(db.stats))throw new Error('Neveljavna lestvica.');
 for(const name of Object.keys(db.stats)){
  const row=db.stats[name];if(name.length>80||!row||!Number.isInteger(row.w)||row.w<0||!Number.isInteger(row.l)||row.l<0)throw new Error('Neveljavna lestvica.');
 }
 if(!Array.isArray(db.games)||db.games.length>10000)throw new Error('Neveljavna zgodovina.');
 if(db.game){
  const g=db.game;if(![301,501].includes(g.start)||!['single','double'].includes(g.finish)||!Array.isArray(g.players)||g.players.length<1||g.players.length>8||!Number.isInteger(g.active)||g.active<0||g.active>=g.players.length||!Array.isArray(g.history))throw new Error('Neveljavna igra.');
  if(g.players.some(p=>typeof p.name!=='string'||p.name.length>80||!Number.isInteger(p.score)||p.score<0||p.score>g.start))throw new Error('Neveljaven rezultat.');
 }
 const json=JSON.stringify(db);if(json.length>2000000)throw new Error('Evidenca je prevelika. Najprej izvozi arhiv.');
 return json;
}
function saveState(payload){
 authorize_();if(!payload||!Number.isInteger(payload.revision)||typeof payload.requestId!=='string'||payload.requestId.length>100)throw new Error('Neveljavna zahteva.');
 const serialized=validateState_(payload.db),lock=LockService.getScriptLock();lock.waitLock(15000);
 try{
  const store=readStore_(),current=store.record;
  if(current.lastRequestId===payload.requestId)return {ok:true,revision:current.revision,updatedAt:current.updatedAt};
  if(current.revision!==payload.revision)return {ok:false,conflict:true,current:current};
  const props=PropertiesService.getScriptProperties(),day=Utilities.formatDate(new Date(),'Europe/Ljubljana','yyyy-MM-dd');
  if(current.revision>0&&props.getProperty('BACKUP_DAY')!==day){
   const folder=dataFolder_(),backups=folder.getFoldersByName('Varnostne kopije'),backupFolder=backups.hasNext()?backups.next():folder.createFolder('Varnostne kopije');
   backupFolder.createFile('pikado-'+day+'-r'+current.revision+'.json',JSON.stringify(current),MimeType.PLAIN_TEXT);
   props.setProperty('BACKUP_DAY',day);
  }
  const next={schema:1,revision:current.revision+1,updatedAt:new Date().toISOString(),db:JSON.parse(serialized),lastRequestId:payload.requestId};
  store.file.setContent(JSON.stringify(next));
  return {ok:true,revision:next.revision,updatedAt:next.updatedAt};
 }finally{lock.releaseLock();}
}

